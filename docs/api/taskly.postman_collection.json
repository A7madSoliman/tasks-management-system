{
  "info": { "name": "Taskly API (Sanitized)", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json" },
  "variable": [
    { "key": "base_url", "value": "" }, { "key": "api_key", "value": "" },
    { "key": "access_token", "value": "" }, { "key": "refresh_token", "value": "" },
    { "key": "user_id", "value": "00000000-0000-0000-0000-000000000000" },
    { "key": "project_id", "value": "00000000-0000-0000-0000-000000000000" },
    { "key": "epic_id", "value": "00000000-0000-0000-0000-000000000000" },
    { "key": "task_id", "value": "00000000-0000-0000-0000-000000000000" }
  ],
  "item": [
    { "name": "1. Auth - Sign Up", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"},{"key":"apikey","value":"{{api_key}}"}], "url": "{{base_url}}/auth/v1/signup", "body": {"mode":"raw","raw":"{\n  \"email\": \"new.user@example.test\",\n  \"password\": \"FakePassword123!\",\n  \"data\": {\"name\": \"Example User\", \"department\": \"Example Department\"}\n}"} } },
    { "name": "2. Auth - Login", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"},{"key":"apikey","value":"{{api_key}}"}], "url": "{{base_url}}/auth/v1/token?grant_type=password", "body": {"mode":"raw","raw":"{\n  \"email\": \"test.user@example.test\",\n  \"password\": \"FakePassword123!\"\n}"} }, "event": [{"listen":"test","script":{"exec":["let response = pm.response.json();","if (response.access_token) {","    pm.collectionVariables.set(\"access_token\", response.access_token);","    pm.collectionVariables.set(\"refresh_token\", response.refresh_token);","    pm.collectionVariables.set(\"user_id\", response.user.id);","}"]}}] },
    { "name": "3. Auth - Get User Data", "request": { "method": "GET", "header": [{"key":"apikey","value":"{{api_key}}"},{"key":"Authorization","value":"Bearer {{access_token}}"},{"key":"Content-Type","value":"application/json"}], "url": "{{base_url}}/auth/v1/user" } },
    { "name": "4. Auth - Update Password", "request": { "method": "PUT", "header": [{"key":"Content-Type","value":"application/json"},{"key":"apikey","value":"{{api_key}}"},{"key":"Authorization","value":"Bearer {{access_token}}"}], "url": "{{base_url}}/auth/v1/user", "body": {"mode":"raw","raw":"{\n  \"password\": \"FakeUpdatedPassword123!\"\n}"} } },
    { "name": "5. Auth - Refresh Token", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"},{"key":"apikey","value":"{{api_key}}"}], "url": "{{base_url}}/auth/v1/token?grant_type=refresh_token", "body": {"mode":"raw","raw":"{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"} }, "event": [{"listen":"test","script":{"exec":["let response = pm.response.json();","if (response.access_token) {","    pm.collectionVariables.set(\"access_token\", response.access_token);","    pm.collectionVariables.set(\"refresh_token\", response.refresh_token);","}"]}}] },
    { "name": "6. Auth - Forgot Password", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"},{"key":"apikey","value":"{{api_key}}"}], "url": "{{base_url}}/auth/v1/recover", "body": {"mode":"raw","raw":"{\n  \"email\": \"test.user@example.test\"\n}"} } },
    { "name": "7. Auth - Logout", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"},{"key":"apikey","value":"{{api_key}}"},{"key":"Authorization","value":"Bearer {{access_token}}"}], "url": "{{base_url}}/auth/v1/logout" } },
    { "name": "8. Projects - Get All Projects", "request": { "method": "GET", "header": [{"key":"apikey","value":"{{api_key}}"},{"key":"Authorization","value":"Bearer {{access_token}}"},{"key":"Content-Type","value":"application/json"}], "url": "{{base_url}}/rest/v1/rpc/get_projects" } },
    { "name": "9. Projects - Create Project", "request": { "method": "POST", "header": [{"key":"apikey","value":"{{api_key}}"},{"key":"Authorization","value":"Bearer {{access_token}}"},{"key":"Content-Type","value":"application/json"},{"key":"Prefer","value":"return=representation"}], "url": "{{base_url}}/rest/v1/projects", "body":{"mode":"raw","raw":"{\"name\":\"Example project\",\"description\":\"Example description\"}"} } },
    { "name": "10. Projects - Update Project", "request": { "method": "PATCH", "header": [{"key":"apikey","value":"{{api_key}}"},{"key":"Authorization","value":"Bearer {{access_token}}"},{"key":"Content-Type","value":"application/json"}], "url": "{{base_url}}/rest/v1/projects?id=eq.{{project_id}}", "body":{"mode":"raw","raw":"{\"name\":\"Example project\",\"description\":\"Example description\"}"} } },
    { "name": "11. Projects - Get Project Members", "request": { "method": "GET", "header": [{"key":"apikey","value":"{{api_key}}"},{"key":"Authorization","value":"Bearer {{access_token}}"},{"key":"Content-Type","value":"application/json"}], "url": "{{base_url}}/rest/v1/get_project_members?project_id=eq.{{project_id}}" } },
    { "name": "12. Projects - Invite Member", "request": { "method": "POST", "header": [{"key":"apikey","value":"{{api_key}}"},{"key":"Authorization","value":"Bearer {{access_token}}"},{"key":"Content-Type","value":"application/json"}], "url": "{{base_url}}/rest/v1/rpc/invite_member", "body":{"mode":"raw","raw":"{\"p_email\":\"invitee@example.test\",\"p_project_id\":\"{{project_id}}\",\"p_app_url\":\"https://example.test\",\"p_base_url\":\"https://example.test\"}"} } },
    { "name": "13. Projects - Accept Invitation", "request": { "method": "POST", "header": [{"key":"apikey","value":"{{api_key}}"},{"key":"Authorization","value":"Bearer {{access_token}}"},{"key":"Content-Type","value":"application/json"}], "url": "{{base_url}}/rest/v1/rpc/accept_invitation", "body":{"mode":"raw","raw":"{\"p_token\":\"FAKE_INVITATION_TOKEN\"}"} } },
    { "name": "14. Epics - Get Project Epics", "request": { "method": "GET", "header": [{"key":"apikey","value":"{{api_key}}"},{"key":"Authorization","value":"Bearer {{access_token}}"},{"key":"Content-Type","value":"application/json"},{"key":"Prefer","value":"count=exact"}], "url": "{{base_url}}/rest/v1/project_epics?project_id=eq.{{project_id}}&limit=10&offset=0" } },
    { "name": "15. Epics - Create Epic", "request": { "method": "POST", "header": [{"key":"apikey","value":"{{api_key}}"},{"key":"Authorization","value":"Bearer {{access_token}}"},{"key":"Content-Type","value":"application/json"},{"key":"Prefer","value":"return=representation"}], "url": "{{base_url}}/rest/v1/epics", "body":{"mode":"raw","raw":"{\"title\":\"Example epic\",\"description\":\"Example description\",\"assignee_id\":\"{{user_id}}\",\"project_id\":\"{{project_id}}\",\"deadline\":\"2030-01-01\"}"} } },
    { "name": "16. Epics - Get Epic Details", "request": { "method": "GET", "header": [{"key":"apikey","value":"{{api_key}}"},{"key":"Authorization","value":"Bearer {{access_token}}"},{"key":"Content-Type","value":"application/json"}], "url": "{{base_url}}/rest/v1/project_epics?project_id=eq.{{project_id}}&id=eq.{{epic_id}}" } },
    { "name": "17. Epics - Update Epic", "request": { "method": "PATCH", "header": [{"key":"apikey","value":"{{api_key}}"},{"key":"Authorization","value":"Bearer {{access_token}}"},{"key":"Content-Type","value":"application/json"}], "url": "{{base_url}}/rest/v1/epics?id=eq.{{epic_id}}", "body":{"mode":"raw","raw":"{\"title\":\"Example epic\",\"description\":\"Example description\"}"} } },
    { "name": "18. Epics - Delete Epic", "request": { "method": "DELETE", "header": [{"key":"apikey","value":"{{api_key}}"},{"key":"Authorization","value":"Bearer {{access_token}}"},{"key":"Content-Type","value":"application/json"}], "url": "{{base_url}}/rest/v1/epics?id=eq.{{epic_id}}" } },
    { "name": "19. Tasks - Get Project Tasks", "request": { "method": "GET", "header": [{"key":"apikey","value":"{{api_key}}"},{"key":"Authorization","value":"Bearer {{access_token}}"},{"key":"Content-Type","value":"application/json"},{"key":"Prefer","value":"count=exact"}], "url": "{{base_url}}/rest/v1/project_tasks?project_id=eq.{{project_id}}" } },
    { "name": "20. Tasks - Get Epic Tasks", "request": { "method": "GET", "header": [{"key":"apikey","value":"{{api_key}}"},{"key":"Authorization","value":"Bearer {{access_token}}"},{"key":"Content-Type","value":"application/json"}], "url": "{{base_url}}/rest/v1/project_tasks?epic_id=eq.{{epic_id}}" } },
    { "name": "21. Tasks - Create Task", "request": { "method": "POST", "header": [{"key":"apikey","value":"{{api_key}}"},{"key":"Authorization","value":"Bearer {{access_token}}"},{"key":"Content-Type","value":"application/json"},{"key":"Prefer","value":"return=representation"}], "url": "{{base_url}}/rest/v1/tasks", "body":{"mode":"raw","raw":"{\"project_id\":\"{{project_id}}\",\"epic_id\":\"{{epic_id}}\",\"title\":\"Example task\",\"description\":\"Example description\",\"assignee_id\":\"{{user_id}}\",\"due_date\":\"2030-01-01\",\"status\":\"TODO\"}"} } },
    { "name": "22. Tasks - Update Task Status", "request": { "method": "PATCH", "header": [{"key":"apikey","value":"{{api_key}}"},{"key":"Authorization","value":"Bearer {{access_token}}"},{"key":"Content-Type","value":"application/json"}], "url": "{{base_url}}/rest/v1/tasks?id=eq.{{task_id}}", "body":{"mode":"raw","raw":"{\"status\":\"TODO\"}"} } },
    { "name": "23. Tasks - Delete Task", "request": { "method": "DELETE", "header": [{"key":"apikey","value":"{{api_key}}"},{"key":"Authorization","value":"Bearer {{access_token}}"},{"key":"Content-Type","value":"application/json"}], "url": "{{base_url}}/rest/v1/tasks?id=eq.{{task_id}}" } }
  ]
}
